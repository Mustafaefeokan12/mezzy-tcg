<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Mezzy TCG Tracker</title>
  
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Mezzy TCG">
  <link rel="apple-touch-icon" href="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/master-ball.png">
  <meta name="theme-color" content="#020617">
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  
  <style>
    :root {
      --bg-dark: #020617;
      --card-bg: rgba(15, 23, 42, 0.75);
      --primary: #3B82F6;
      --primary-glow: rgba(59, 130, 246, 0.4);
      --success: #10B981;
      --success-glow: rgba(16, 185, 129, 0.3);
      --danger: #EF4444;
      --warning: #F59E0B;
      --purple: #A855F7;
      --text-main: #F8FAFC;
      --text-muted: #94A3B8;
      --glass-border: rgba(255, 255, 255, 0.08);
      --binder-bg: #1E293B;
    }
    * { box-sizing: border-box; -webkit-touch-callout: none; }
    body { 
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-dark); color: var(--text-main); 
      margin: 0; padding: 15px; padding-bottom: 95px;
      min-height: 100vh; overflow-x: hidden;
    }
    .app-container { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }
    .header { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 5px; }
    .header img { width: 36px; filter: drop-shadow(0 0 6px var(--primary-glow)); }
    .header h1 { font-size: 22px; margin: 0; background: linear-gradient(90deg, #60A5FA, #A78BFA); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 800; }
    
    .panel { background: var(--card-bg); padding: 18px; border-radius: 18px; border: 1px solid var(--glass-border); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
    .panel-title { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; font-weight: 700; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; }
    .val-container { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
    .val { font-size: 30px; font-weight: 950; color: #FFF; text-shadow: 0 2px 15px var(--primary-glow); }
    .currency-toggle { background: var(--primary); color: white; border: none; padding: 6px 12px; border-radius: 8px; font-weight: 700; cursor:pointer;}
    .stats { display: flex; flex-wrap: wrap; gap: 12px; border-top: 1px solid var(--glass-border); padding-top: 14px; margin-bottom: 10px; }
    .stat-box { flex: 1 1 45%; }
    .stat-label { font-size: 10px; color: var(--text-muted); text-transform: uppercase; margin-bottom:4px;}
    .stat-value { font-size: 15px; font-weight: 800; }
    .green { color: var(--success); } .red { color: var(--danger); }
    .chart-container { position: relative; height: 150px; border-top: 1px dashed var(--glass-border); padding-top: 14px; margin-top:5px; }
    
    .data-section { background: rgba(30, 58, 138, 0.25); border-color: rgba(59, 130, 246, 0.3); text-align: center; }
    .chat-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
    .chat-row { display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.3); padding: 8px 12px; border-radius: 10px; font-size: 12px; border: 1px solid var(--glass-border); color: #BFDBFE; }
    .chat-del-btn { background: rgba(239, 68, 68, 0.2); color: #FCA5A5; border: none; padding: 4px 8px; border-radius: 6px; font-weight: bold; font-size: 10px; cursor:pointer;}
    
    .file-btn { background: var(--primary); color: white; padding: 12px; border-radius: 10px; font-weight: bold; display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 13px; width: 100%; border: none; box-sizing: border-box; cursor:pointer;}
    .db-status { font-size: 11px; color: #93C5FD; margin-top: 8px; }

    input.text-input, select { width: 100%; box-sizing: border-box; background: rgba(0,0,0,0.3); border: 1px solid var(--glass-border); color: white; padding: 13px; border-radius: 12px; margin-bottom: 12px; font-size: 14px; outline: none; font-weight: 500; }
    .selected-chip { display: flex; justify-content: space-between; align-items: center; background: rgba(16, 185, 129, 0.1) !important; border-color: rgba(16, 185, 129, 0.4) !important; padding: 12px 14px !important; margin-bottom: 12px; }
    .clear-chip-btn { background: var(--danger); color: #FFF; border: none; border-radius: 50%; width: 26px; height: 26px; font-weight: bold; display: flex; align-items: center; justify-content: center; cursor:pointer;}
    .row { display: flex; gap: 10px; }
    button.add-btn { width: 100%; background: var(--success); color: white; border: none; padding: 15px; border-radius: 12px; font-size: 15px; font-weight: 800; box-shadow: 0 4px 12px var(--success-glow); cursor:pointer;}
    
    .search-results { position: absolute; top: 52px; left: 0; right: 0; background: #0F172A; border: 1px solid var(--primary); border-radius: 12px; max-height: 250px; overflow-y: auto; z-index: 100; display: none; box-shadow: 0 15px 30px rgba(0,0,0,0.8); }
    .suggestion-item { padding: 12px 14px; border-bottom: 1px solid var(--glass-border); cursor:pointer;}
    .suggestion-item:active { background: rgba(59, 130, 246, 0.15); }
    
    .card-list { display: flex; flex-direction: column; gap: 12px; }
    .card-item { display: flex; flex-direction: column; gap: 10px; padding: 16px; margin-bottom: 0 !important; }
    .roi-badge { background: rgba(168, 85, 247, 0.15); color: #D8B4FE; padding: 3px 7px; border-radius: 6px; font-size: 10px; font-weight: 800; display: inline-block; margin-bottom: 4px; border: 1px solid rgba(168,85,247,0.3); }
    .card-actions { display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.25); padding: 8px 12px; border-radius: 10px; border: 1px solid var(--glass-border); flex-wrap:wrap; gap:8px;}
    .qty-controls { display: flex; align-items: center; gap: 10px; }
    .qty-btn { background: rgba(255,255,255,0.1); border: none; color: white; width: 28px; height: 28px; border-radius: 6px; font-size: 16px; font-weight: bold; cursor:pointer;}
    .wts-btn { background: rgba(59, 130, 246, 0.15); color: #93C5FD; border: 1px solid rgba(59,130,246,0.3); padding: 6px 10px; border-radius: 6px; font-weight: 700; font-size: 11px; cursor:pointer;}
    .delete-btn { background: transparent; color: #FCA5A5; border: 1px solid rgba(239,68,68,0.3); padding: 6px 10px; border-radius: 6px; font-weight: 700; font-size: 11px; cursor:pointer;}

    .product-icon { width:44px; height:44px; min-width:44px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:12px; display:flex; justify-content:center; align-items:center; font-size:22px; }

    .market-ticker-card { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; background: var(--card-bg); border: 1px solid var(--glass-border); border-radius: 16px; cursor: pointer; transition: all 0.2s ease; }
    .market-ticker-card:active { transform: scale(0.98); background: rgba(30, 58, 138, 0.2); border-color: var(--primary); }
    .ticker-left { display: flex; align-items: center; gap: 12px; flex: 1; }
    .ticker-right { text-align: right; }

    /* ALT NAVİGASYON */
    .bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; height: 68px; background: rgba(2, 6, 23, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-top: 1px solid var(--glass-border); display: flex; justify-content: space-around; align-items: center; z-index: 1000; }
    .nav-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; color: var(--text-muted); font-size: 11px; font-weight: 600; cursor: pointer; flex: 1; padding: 8px 0; transition: color 0.2s; }
    .nav-item.active { color: var(--primary); font-weight: 800; }
    .nav-item span.icon { font-size: 20px; }

    .page-section { display: none; opacity: 0; transform: translateY(6px); transition: opacity 0.25s ease, transform 0.25s ease; }
    .page-section.active { display: flex; flex-direction: column; gap: 16px; opacity: 1; transform: translateY(0); }

    /* MODAL TASARIMLARI */
    .modal-overlay { display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.85); z-index:9999; justify-content:center; align-items:center; backdrop-filter:blur(8px); }
    .modal-content { width:100%; max-width:500px; max-height: 90vh; overflow-y: auto; background: #0B132B; border: 1px solid rgba(59,130,246,0.3); padding: 22px; border-radius: 24px; box-shadow: 0 10px 40px rgba(0,0,0,0.9); }
    .modal-overlay.bottom-modal { align-items:flex-end; }
    .modal-overlay.bottom-modal .modal-content { border-radius:0; border-top-left-radius: 24px; border-top-right-radius: 24px; }
    
    .sell-row { display:flex; gap:10px; margin-bottom:10px; align-items:center; }
    .sell-row .text-input { margin-bottom:0; padding:12px; font-size:13px; }
    .del-row-btn { background:var(--danger); border:none; border-radius:10px; color:#fff; font-weight:bold; height:42px; width:42px; cursor:pointer; display:flex; justify-content:center; align-items:center; }
    
    .listing-item { background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); padding: 10px 14px; border-radius: 12px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;}

    /* --- BINDER (KOLEKSİYON DEFTERİ) STİLLERİ --- */
    .binder-wrapper { display: flex; flex-direction: column; align-items: center; width: 100%; overflow: hidden; position: relative; touch-action: pan-y; }
    .binder-spread { display: flex; width: 100%; max-width: 800px; gap: 6px; transform-origin: center center; transition: transform 0.3s ease; }
    
    /* Çift tık ile zoom (scale) efekti */
    .binder-wrapper.zoomed .binder-spread { transform: scale(1.6); z-index: 50; }
    
    .binder-page { flex: 1; background: #1e293b; border-radius: 6px; border: 2px solid #334155; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); gap: 4px; padding: 6px; box-shadow: inset 0 0 15px rgba(0,0,0,0.6); position: relative; }
    .binder-page.left-page { box-shadow: inset -15px 0 20px -5px rgba(0,0,0,0.8); border-right: 1px solid #0f172a; border-top-right-radius: 2px; border-bottom-right-radius: 2px; }
    .binder-page.right-page { box-shadow: inset 15px 0 20px -5px rgba(0,0,0,0.8); border-left: 1px solid #0f172a; border-top-left-radius: 2px; border-bottom-left-radius: 2px; }
    
    .binder-slot { aspect-ratio: 63 / 88; background: rgba(255,255,255,0.03); border: 1px dashed rgba(255,255,255,0.15); border-radius: 4px; display: flex; justify-content: center; align-items: center; cursor: pointer; position: relative; overflow: hidden; transition: all 0.2s; }
    .binder-slot:hover { border-color: rgba(255,255,255,0.4); background: rgba(255,255,255,0.08); }
    .binder-slot .empty-icon { font-size: 24px; color: rgba(255,255,255,0.2); font-weight: 100; }
    .binder-slot img.card-img { width: 100%; height: 100%; object-fit: cover; border-radius: 3px; }

    /* 3D Holo Modal Stilleri */
    #holoCardContainer { perspective: 1000px; display: flex; justify-content: center; align-items: center; width: 100%; height: 60vh; margin-top: 20px;}
    .card-3d-wrapper { width: 280px; aspect-ratio: 63 / 88; position: relative; transform-style: preserve-3d; transition: transform 0.1s ease-out; box-shadow: 0 20px 50px rgba(0,0,0,0.8); border-radius: 12px; }
    .card-3d-wrapper img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; display: block; }
    .holo-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; border-radius: 12px; background: linear-gradient(115deg, transparent 20%, rgba(255, 215, 0, 0.3) 25%, rgba(255, 255, 255, 0.5) 28%, rgba(0, 255, 255, 0.3) 31%, transparent 36%); background-size: 300% 300%; mix-blend-mode: color-dodge; pointer-events: none; transition: background-position 0.1s ease-out; background-position: 50% 50%; opacity: 0; }

    .page-indicator { text-align: center; color: var(--text-muted); font-size: 12px; margin-top: 15px; font-weight: 700; letter-spacing: 2px; }
    .zoom-btn { background: rgba(59, 130, 246, 0.2); border: 1px solid var(--primary); color: #93C5FD; padding: 6px 12px; border-radius: 20px; font-size: 11px; font-weight: bold; margin: 0 auto 10px auto; display: block; cursor: pointer; }
  </style>
</head>
<body>

  <div class="app-container">
    <div class="header">
      <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/master-ball.png" alt="Pokeball">
      <h1>Mezzy TCG Tracker</h1>
    </div>

    <!-- SAYFA 1: PORTFÖY & ENVANTER -->
    <div id="pagePortfolio" class="page-section active">
      
      <div class="panel" style="background: rgba(168, 85, 247, 0.15); border-color: rgba(168, 85, 247, 0.3);">
        <div class="panel-title" style="color: #D8B4FE;">🔄 Cihazlar Arası Aktarım & Yedek</div>
        <div style="display:flex; gap:10px; margin-top:4px;">
          <button onclick="exportData()" class="file-btn" style="flex:1; background:rgba(59, 130, 246, 0.2); border:1px solid var(--primary); color:#93C5FD;">📤 Yedeği Paylaş</button>
          <label class="file-btn" style="flex:1; background:rgba(16, 185, 129, 0.2); border:1px solid var(--success); color:#34D399; cursor:pointer;">
            📥 Yedeği Yükle
            <input type="file" accept=".json" style="display:none;" onchange="importData(event)">
          </label>
        </div>
      </div>

      <div class="panel data-section">
        <div class="panel-title" style="color:#FFF; justify-content:center;">WhatsApp Veritabanı</div>
        <div id="chatManager" class="chat-list"></div>
        <div style="position:relative;">
          <label class="file-btn" for="fileInput">📁 WhatsApp ZIP Ekle</label>
          <input type="file" accept=".zip" id="fileInput" style="display:none;" onchange="parseWhatsAppZip(event)">
        </div>
        <div class="db-status" id="dbStatus">Sistem Hazır</div>
      </div>

      <div class="panel">
        <div class="panel-title">
          <span>Portföy Finansal Özeti</span>
          <span id="rateInfo" style="font-size: 9px; color: var(--primary);">Kur Çekiliyor...</span>
        </div>
        <div class="val-container">
          <div class="val" id="totalValue">0 ₺</div>
          <button class="currency-toggle" onclick="toggleCurrency()">₺ / $</button>
        </div>
        <div class="stats">
          <div class="stat-box">
            <div class="stat-label">Toplam Harcanan</div>
            <div class="stat-value" id="totalSpent">0 ₺</div>
          </div>
          <div class="stat-box" style="text-align: right;">
            <div class="stat-label">Aktif Maliyet (Stok)</div>
            <div class="stat-value" id="totalCost">0 ₺</div>
          </div>
          <div class="stat-box">
            <div class="stat-label">Beklenen Kâr (Aktif)</div>
            <div class="stat-value" id="expectedProfit">+0 ₺</div>
          </div>
          <div class="stat-box" style="text-align: right;">
            <div class="stat-label">Gerçekleşen Kâr (Net)</div>
            <div class="stat-value" id="realizedProfit">+0 ₺</div>
          </div>
        </div>
        <div class="chart-container">
          <canvas id="portfolioChart"></canvas>
        </div>
      </div>

      <div class="panel">
        <div style="position:relative; margin-bottom:12px;">
          <div style="display:flex; gap:8px;">
            <input type="text" id="cardName" class="text-input" placeholder="🔍 Ürün ara (örn: 151, First Partner)..." oninput="searchLocal(event)" autocomplete="off" style="margin-bottom:0; flex:1;">
            <button class="file-btn" style="width:52px; background:rgba(16, 185, 129, 0.2); border:1px solid rgba(16, 185, 129, 0.4); color:#34D399; font-size:26px; padding:0; border-radius:12px; cursor:pointer; display:flex; justify-content:center; align-items:center;" onclick="openManualAddModal()">+</button>
          </div>
          <div class="search-results" id="searchResults"></div>
        </div>
        
        <div id="selectedCardChip" class="text-input selected-chip" style="display:none;">
          <span id="selectedCardNameText" style="font-weight:600; color:#34D399; font-size:13px; flex:1; line-height:1.4;"></span>
          <button class="clear-chip-btn" onclick="clearSelection()">✖</button>
        </div>

        <div class="row" style="margin-bottom:12px;">
          <input type="number" id="buyPrice" class="text-input" placeholder="Birim Alış (₺)" style="flex:1; margin-bottom:0;">
          <input type="number" id="currentPrice" class="text-input" placeholder="Piyasa Değeri (₺)" style="flex:1; margin-bottom:0;">
        </div>
        <div class="row">
          <input type="number" id="qtyInput" class="text-input" value="1" min="1" placeholder="Adet" style="flex:1;">
        </div>
        <button class="add-btn" onclick="addCard()">Portföye Ekle</button>
      </div>

      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
          <span style="font-size:12px; font-weight:bold; color:var(--text-muted);">Aktif Envanter</span>
          <select id="sortFilter" style="background:rgba(0,0,0,0.4); border:1px solid var(--glass-border); color:#FFF; padding:6px 10px; border-radius:8px; font-size:11px; outline:none;" onchange="renderCards()">
            <option value="newest">En Yeni</option>
            <option value="profitDesc">Kârı Yüksek</option>
            <option value="costDesc">Maliyeti Yüksek</option>
            <option value="az">A-Z</option>
          </select>
        </div>
        <div class="card-list" id="cardList"></div>
      </div>

      <div style="margin-top: 20px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
          <span style="font-size:12px; font-weight:bold; color:var(--text-muted);">Satılanlar (Geçmiş)</span>
        </div>
        <div class="card-list" id="soldList"></div>
      </div>

    </div>

    <!-- SAYFA 2: PİYASA TAKİBİ -->
    <div id="pageMarket" class="page-section">
      <div class="panel" style="background: linear-gradient(135deg, rgba(30,58,138,0.3), rgba(15,23,42,0.8)); border-color: rgba(59,130,246,0.3);">
        <div class="panel-title" style="color: #60A5FA;">📊 TCG Piyasa Terminali</div>
        <div style="font-size: 13px; color: var(--text-muted); line-height: 1.4;">
          WhatsApp gruplarındaki ilanlar "Pozitif İnşa" algoritmasıyla eksiksiz taranarak birleştirilmiş borsa listesidir. Detay ve fiyat grafiği için ürüne dokunun.
        </div>
      </div>

      <div style="position:relative;">
        <input type="text" id="marketSearchInput" class="text-input" placeholder="🔍 Piyasa terminalinde ara..." oninput="renderMarketList()" style="margin-bottom:6px;">
      </div>

      <div id="marketSummaryCount" style="font-size:11px; color:var(--text-muted); font-weight:700; padding: 0 4px;">0 Farklı Ürün Takipte</div>
      <div id="marketTickerList" style="display:flex; flex-direction:column; gap:10px;"></div>
    </div>

    <!-- SAYFA 3: BINDER (KOLEKSİYON DEFTERİ) -->
    <div id="pageBinder" class="page-section">
      <div class="panel" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(15,23,42,0.8)); border-color: rgba(16, 185, 129, 0.3);">
        <div class="panel-title" style="color: #34D399;">📓 Dijital Binder</div>
        <div style="font-size: 12px; color: var(--text-muted); line-height: 1.4;">
          Fiziksel kart albümünüz. Sayfaları çevirmek için albümü <b>sağa/sola kaydırın.</b> Büyütmek için <b>Çift Tıklayın</b> veya <b>Zoom</b> butonuna basın. Kart eklemek için boş yuvalara dokunun.
        </div>
      </div>

      <button class="zoom-btn" onclick="toggleBinderZoom()">🔍 Zoom Değiştir</button>

      <!-- BINDER SPREAD ALANI -->
      <div class="binder-wrapper" id="binderWrapper">
        <div class="binder-spread" id="binderSpread">
          <!-- JS ile Render Edilecek -->
        </div>
      </div>
      <div class="page-indicator" id="binderPageIndicator">SAYFA 1 - 2</div>
    </div>

  </div>

  <!-- ALT MENÜ (iOS TAB BAR) -->
  <div class="bottom-nav">
    <div id="tabPortfolio" class="nav-item active" onclick="switchTab('portfolio')">
      <span class="icon">📦</span><span>Portföy</span>
    </div>
    <div id="tabMarket" class="nav-item" onclick="switchTab('market')">
      <span class="icon">📈</span><span>Piyasa</span>
    </div>
    <div id="tabBinder" class="nav-item" onclick="switchTab('binder')">
      <span class="icon">📓</span><span>Binder</span>
    </div>
  </div>

  <!-- BINDER KART EKLEME MODALI -->
  <div id="binderAddModal" class="modal-overlay">
    <div class="modal-content">
       <div style="display:flex; justify-content:space-between; margin-bottom:5px;">
         <h3 style="margin:0; color:#FFF; font-size:16px;">➕ Binder'a Kart Ekle</h3>
         <button onclick="closeBinderAddModal()" style="background:none; border:none; color:var(--text-muted); font-size:20px; cursor:pointer; padding:0;">✖</button>
       </div>
       <p style="font-size:11px; color:var(--text-muted); margin-bottom:15px;">Yuva: Sayfa <span id="lblAddPage"></span>, Slot <span id="lblAddSlot"></span></p>
       
       <input type="text" id="bCardName" class="text-input" placeholder="Kart Adı (Örn: Charizard ex)">
       <input type="text" id="bCardCode" class="text-input" placeholder="Kart Kodu (Örn: MEW 199/165)">
       
       <label class="file-btn" style="background:rgba(59, 130, 246, 0.2); border:1px dashed var(--primary); color:#93C5FD; margin-bottom:15px;">
         📸 Kart Fotoğrafı Yükle / Çek
         <input type="file" accept="image/*" id="bCardImage" style="display:none;" onchange="previewBinderImage(event)">
       </label>
       
