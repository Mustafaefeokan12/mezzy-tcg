  <script>
    // --- VERİ MODELİ ---
    let collection = JSON.parse(localStorage.getItem('pkmn_sealed_collection')) || [];
    let uploadedChats = JSON.parse(localStorage.getItem('wa_chats_array')) || [];
    let binderData = JSON.parse(localStorage.getItem('pkmn_binder_data')) || {}; 
    let localMarketData = []; 
    let currentCurrency = 'TRY';
    let usdRate = 35.0; 
    let portfolioChart = null;
    let marketDetailChart = null;
    let currentSellId = null;

    // --- BINDER DEĞİŞKENLERİ ---
    let currentSpread = 0; 
    let totalSpreads = 1; 
    let currentAddSlot = null; 
    let currentBase64Image = null;
    
    // Swipe işlemleri için
    let touchStartX = 0;
    let touchEndX = 0;
    const pageTurnAudio = new Audio('https://actions.google.com/sounds/v1/foley/swipe_whoosh.ogg');
    pageTurnAudio.volume = 0.5;

    const jpExclusiveSets = ["terastal", "vstar universe", "shiny treasure", "eevee heroes", "clay burst", "snow hazard", "ruler of the black flame", "wild force", "cyber judge", "crimson haze", "mask of change", "night wanderer", "stellar miracle", "paradigm trigger", "incandescent arcana", "lost abyss", "dark phantasma", "time gazer", "space juggler", "battle region", "star birth", "vmax climax", "shiny star v", "tag all stars"];
    const cnExclusiveSets = ["gem pack", "nine color", "crossing the sky", "shadow of glory", "brave stars", "pinnacle clash", "dynamax clash", "sun & moon"];

    async function initApp() {
      refreshDatabase();
      try {
        let res = await fetch('https://api.exchangerate-api.com/v4/latest/USD');
        let data = await res.json();
        usdRate = data.rates.TRY;
        document.getElementById('rateInfo').innerText = `1$ = ${usdRate.toFixed(2)}₺`;
      } catch(e) { document.getElementById('rateInfo').innerText = `Kur: 35.0₺`; }
      renderDashboard(); 
      renderCards();
      renderMarketList();
      initBinder(); // Binder verilerini hesapla ve çiz
    }

    // --- BINDER (DİJİTAL ALBÜM) FONKSİYONLARI ---
    function initBinder() {
      let maxPage = 2; 
      Object.keys(binderData).forEach(key => {
         let pNum = parseInt(key.split('_')[1]);
         if(pNum > maxPage) maxPage = pNum;
      });
      totalSpreads = Math.ceil(maxPage / 2);
      totalSpreads += 1; // Her zaman boş sayfa payı bırak
      
      renderBinderSpread();
      setupBinderSwipe();
      setupHoloEffect();
    }

    function renderBinderSpread() {
      const spreadEl = document.getElementById('binderSpread');
      if(!spreadEl) return;
      spreadEl.innerHTML = '';
      
      let leftPageNum = (currentSpread * 2) + 1;
      let rightPageNum = (currentSpread * 2) + 2;

      let leftPageHTML = `<div class="binder-page left-page">`;
      for(let i=1; i<=9; i++) {
        let slotKey = `page_${leftPageNum}_slot_${i}`;
        leftPageHTML += createSlotHTML(slotKey);
      }
      leftPageHTML += `</div>`;

      let rightPageHTML = `<div class="binder-page right-page">`;
      for(let i=1; i<=9; i++) {
        let slotKey = `page_${rightPageNum}_slot_${i}`;
        rightPageHTML += createSlotHTML(slotKey);
      }
      rightPageHTML += `</div>`;

      spreadEl.innerHTML = leftPageHTML + rightPageHTML;
      document.getElementById('binderPageIndicator').innerText = `SAYFA ${leftPageNum} - ${rightPageNum}`;
    }

    function createSlotHTML(slotKey) {
       let card = binderData[slotKey];
       if(card) {
          return `<div class="binder-slot" onclick="openBinderViewModal('${slotKey}')"><img src="${card.image}" class="card-img"></div>`;
       } else {
          return `<div class="binder-slot" onclick="openBinderAddModal('${slotKey}')"><span class="empty-icon">+</span></div>`;
       }
    }

    function toggleBinderZoom() {
      let wrapper = document.getElementById('binderWrapper');
      wrapper.classList.toggle('zoomed');
    }

    function setupBinderSwipe() {
      const bCont = document.getElementById('binderContainer');
      bCont.addEventListener('touchstart', e => { touchStartX = e.changedTouches[0].screenX; });
      bCont.addEventListener('touchend', e => {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
      });

      let lastTap = 0;
      bCont.addEventListener('touchend', function(e) {
          let currentTime = new Date().getTime();
          let tapLength = currentTime - lastTap;
          if (tapLength < 300 && tapLength > 0) {
              toggleBinderZoom();
              e.preventDefault();
          }
          lastTap = currentTime;
      });
    }

    function handleSwipe() {
       let threshold = 50;
       if (touchEndX < touchStartX - threshold) {
          if(currentSpread < totalSpreads - 1) { currentSpread++; playPageTurn(); renderBinderSpread(); }
       }
       if (touchEndX > touchStartX + threshold) {
          if(currentSpread > 0) { currentSpread--; playPageTurn(); renderBinderSpread(); }
       }
    }

    function playPageTurn() {
      pageTurnAudio.currentTime = 0;
      pageTurnAudio.play().catch(e => console.log("Ses oynatılamadı:", e));
    }

    function openBinderAddModal(slotKey) {
       currentAddSlot = slotKey;
       let parts = slotKey.split('_');
       document.getElementById('lblAddPage').innerText = parts[1];
       document.getElementById('lblAddSlot').innerText = parts[3];
       document.getElementById('bCardName').value = '';
       document.getElementById('bCardCode').value = '';
       document.getElementById('bImagePreview').style.display = 'none';
       document.getElementById('bPreviewImg').src = '';
       currentBase64Image = null;
       document.getElementById('binderAddModal').style.display = 'flex';
    }

    function closeBinderAddModal() { document.getElementById('binderAddModal').style.display = 'none'; }

    function previewBinderImage(event) {
       const file = event.target.files[0];
       if(!file) return;
       const reader = new FileReader();
       reader.onload = function(e) {
          const img = new Image();
          img.onload = function() {
             const canvas = document.createElement('canvas');
             const ctx = canvas.getContext('2d');
             const MAX_WIDTH = 400; // Sıkıştırma ayarı
             let scaleSize = MAX_WIDTH / img.width;
             if(scaleSize > 1) scaleSize = 1; 
             canvas.width = img.width * scaleSize; canvas.height = img.height * scaleSize;
             ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
             currentBase64Image = canvas.toDataURL('image/jpeg', 0.65);
             document.getElementById('bPreviewImg').src = currentBase64Image;
             document.getElementById('bImagePreview').style.display = 'block';
          }
          img.src = e.target.result;
       }
       reader.readAsDataURL(file);
    }

    function saveBinderCard() {
       let name = document.getElementById('bCardName').value.trim();
       let code = document.getElementById('bCardCode').value.trim();
       if(!name || !currentBase64Image) { alert("Lütfen kart adı girin ve fotoğraf yükleyin!"); return; }
       binderData[currentAddSlot] = { name: name, code: code, image: currentBase64Image };
       localStorage.setItem('pkmn_binder_data', JSON.stringify(binderData));
       closeBinderAddModal(); initBinder();
    }

    let currentViewSlot = null;
    function openBinderViewModal(slotKey) {
       let card = binderData[slotKey];
       if(!card) return;
       currentViewSlot = slotKey;
       document.getElementById('bViewName').innerText = card.name;
       document.getElementById('bViewCode').innerText = card.code || '';
       document.getElementById('holoCardImg').src = card.image;
       document.getElementById('holoCardWrapper').style.transform = `rotateX(0deg) rotateY(0deg)`;
       document.getElementById('holoOverlay').style.opacity = '0';
       document.getElementById('binderViewModal').style.display = 'flex';
    }

    function closeBinderViewModal() {
       document.getElementById('binderViewModal').style.display = 'none';
       currentViewSlot = null;
    }

    function removeBinderCard() {
       if(confirm("Bu kartı binder'dan silmek istediğinize emin misiniz?")) {
          delete binderData[currentViewSlot];
          localStorage.setItem('pkmn_binder_data', JSON.stringify(binderData));
          closeBinderViewModal(); initBinder();
       }
    }

    function setupHoloEffect() {
       const wrapper = document.getElementById('holoCardWrapper');
       const overlay = document.getElementById('holoOverlay');

       function applyTilt(clientX, clientY) {
          let rect = wrapper.getBoundingClientRect();
          let x = clientX - rect.left; let y = clientY - rect.top;
          let centerX = rect.width / 2; let centerY = rect.height / 2;
          let rotateX = ((y - centerY) / centerY) * -20; 
          let rotateY = ((x - centerX) / centerX) * 20;
          wrapper.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
          overlay.style.opacity = '0.8';
          overlay.style.backgroundPosition = `${(x / rect.width) * 100}% ${(y / rect.height) * 100}%`;
       }
       function resetTilt() {
          wrapper.style.transform = `rotateX(0deg) rotateY(0deg)`;
          overlay.style.opacity = '0';
       }

       wrapper.addEventListener('mousemove', e => applyTilt(e.clientX, e.clientY));
       wrapper.addEventListener('mouseleave', resetTilt);
       wrapper.addEventListener('touchmove', e => {
          e.preventDefault(); 
          applyTilt(e.touches[0].clientX, e.touches[0].clientY);
       }, { passive: false });
       wrapper.addEventListener('touchend', resetTilt);
    }

    // --- TAB GEÇİŞLERİ ---
    function switchTab(tabName) {
      document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.page-section').forEach(el => el.classList.remove('active'));

      if (tabName === 'portfolio') {
        document.getElementById('tabPortfolio').classList.add('active');
        document.getElementById('pagePortfolio').classList.add('active');
      } else if (tabName === 'market') {
        document.getElementById('tabMarket').classList.add('active');
        document.getElementById('pageMarket').classList.add('active');
        renderMarketList();
      } else if (tabName === 'binder') {
        document.getElementById('tabBinder').classList.add('active');
        document.getElementById('pageBinder').classList.add('active');
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function toggleCurrency() { 
      currentCurrency = currentCurrency === 'TRY' ? 'USD' : 'TRY'; 
      renderDashboard(); 
      renderCards();
      renderMarketList();
    }

    // --- YEDEKLEME (BINDER DAHİL) ---
    function exportData() {
      const dataToExport = { collection: collection, chats: uploadedChats, binder: binderData };
      const jsonStr = JSON.stringify(dataToExport);
      const fileName = "mezzy_tcg_yedek.json";
      const blob = new Blob([jsonStr], { type: "application/json" });
      if (navigator.canShare && navigator.canShare({ files: [new File([blob], fileName, { type: "application/json" })] })) {
        navigator.share({ files: [new File([blob], fileName, { type: "application/json" })], title: 'Mezzy TCG Yedek' }).catch(err => console.log(err));
      } else {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a'); a.href = url; a.download = fileName;
        document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
      }
    }

    function importData(event) {
      const file = event.target.files[0]; if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const data = JSON.parse(e.target.result);
          if (data.collection) localStorage.setItem('pkmn_sealed_collection', JSON.stringify(data.collection));
          if (data.chats) localStorage.setItem('wa_chats_array', JSON.stringify(data.chats));
          if (data.binder) localStorage.setItem('pkmn_binder_data', JSON.stringify(data.binder));
          alert("Veriler başarıyla yüklendi! Sayfa yenileniyor..."); location.reload();
        } catch (err) { alert("Geçersiz yedek dosyası!"); }
      }; reader.readAsText(file);
    }

    // --- ESKİ PORTFÖY VE PİYASA MANTIĞI ---
    function extractCleanName(text) {
      let clean = text.toLowerCase();
      let etbCount = (clean.match(/\betb\b/gi) || []).length + (clean.match(/\belite trainer box\b/gi) || []).length;
      let boxCount = (clean.match(/\bbooster box\b/gi) || []).length;
      if (etbCount > 1 || boxCount > 1) return ""; 

      let isPC = clean.includes("pokemon center") || clean.includes("pc etb") || clean.includes("center") || clean.includes("centerdan");

      if (clean.includes("yarım") || clean.includes("yarim") || clean.includes("half")) {
         if (clean.includes("booster box")) clean = clean.replace(/yarım|yarim|half/g, '').replace("booster box", "half booster box");
      }

      let sets = [
        "prismatic evolutions", "destined rivals", "twilight masquerade", "stellar miracle", "stellar crown",
        "surging sparks", "obsidian flames", "paldean fates", "paldea evolved", "temporal forces",
        "paradox rift", "crown zenith", "silver tempest", "lost origin", "brilliant stars", 
        "fusion strike", "evolving skies", "chilling reign", "vivid voltage", "vstar universe",
        "shiny treasure", "vmax climax", "eevee heroes", "clay burst", "snow hazard",
        "ruler of the black flame", "wild force", "cyber judge", "crimson haze", "mask of change",
        "night wanderer", "paradigm trigger", "incandescent arcana", "lost abyss", "dark phantasma",
        "time gazer", "space juggler", "battle region", "star birth", "shiny star v", "tag all stars",
        "ascended heroes", "spiritforged", "perfect order", "phantasmal flames", "chaos rising",
        "pitch black", "white flare", "151", "greninja ex", "kingdra ex", "cynthia's garchomp ex",
        "houndstone ex", "mewtwo ex", "charizard ex", "charizard", "zacian", "pikachu",
        "first partner 1", "first partner 2", "first partner 3", "first partner"
      ].sort((a, b) => b.length - a.length);

      let types = [
        "ultra premium collection", "elite trainer box", "special collection box", "premium collection",
        "collection box", "half booster box", "booster bundle", "booster box", "sleeved booster pack", "3pack blister",
        "3-pack blister", "3 pack blister", "blister pack", "booster pack", "mini tin", "deck box",
        "ex box", "tin", "deck", "upc", "etb", "pack", "collection", "koleksiyonu", "koleksiyon", "set"
      ].sort((a, b) => b.length - a.length);

      let foundSet = sets.find(s => clean.includes(s));
      let foundType = types.find(t => clean.includes(t));

      if (foundSet && foundType) {
        let finalType = foundType.replace("elite trainer box", "etb").replace("ultra premium collection", "upc").replace("3pack blister", "3-pack blister").replace("3 pack blister", "3-pack blister").replace("koleksiyonu", "collection").replace("koleksiyon", "collection");
        let finalSetStr = foundSet.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
        let finalTypeStr = finalType.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
        finalTypeStr = finalTypeStr.replace(/\bEtb\b/g, "ETB").replace(/\bUpc\b/g, "UPC").replace(/\bEx\b/g, "EX");
        finalSetStr = finalSetStr.replace(/\bEx\b/g, "EX");
        let finalName = finalSetStr + " " + finalTypeStr;
        if (isPC) finalName += " Pokemon Center";
        return finalName;
      }
      
      clean = clean.replace(/https?:\/\/[^\s]+/gi, ' ').replace(/\b(https|http|www|com|kartfiyat|listings)\b/gi, ' ').replace(/\b\d{1,2}[\s\.\/]\d{1,2}[\s\.\/]\d{2,4}[\s\-]*\d{1,2}[\s\.\:]\d{1,2}(?:[\s\.\:]\d{1,2})?\b/g, ' ').replace(/\d{1,3}(?:[\.\,\s]\d{3})*(?:[\.\,]\d+)?\s*(tl|₺|usd|\$|try)\b/gi, ' ').replace(/\(?\d+\s*(x|adet)\)?/gi, ' ');
      let typeMatch = clean.match(/(.*?)\b(etb|upc|booster box|booster bundle|booster pack|blister|tin|deck box|deck|ex box|collection box|premium collection|special collection)\b(.*)/i);
      if (typeMatch) { clean = typeMatch[1] + " " + typeMatch[2]; }
      const garbage = ["ankara", "istanbul", "izmir", "içi", "elden", "teslim", "her", "yere", "kargo", "yapılır", "görüntü", "goruntu", "stok", "pokemon", "sealed", "takas", "teklif", "değerlendirilir", "adet fiyatı", "aldım diyene", "aldim diyene", "bugüne özel", "alana", "satılık", "satilik", "wts", "acil", "karışık", "mevcut", "son", "tekli", "satılmıştır", "satildi", "hepsini", "fırsatı kaçırma", "cooland1", "gelme", "ilan", "tcg", "paket"];
      garbage.forEach(w => { clean = clean.replace(new RegExp(`\\b${w}\\b`, 'gi'), ' '); });
      const names = ["binali akkuş", "binali", "akkuş", "burak ceylan", "burak", "ceylan", "ökmen", "sinan demir", "sinan", "demir", "bilgehan", "melih", "mert acar", "mert soylu", "mert", "acar", "soylu", "colakoglu", "çolakoğlu", "öztürk", "s öztürk", "s ozturk", "ömer", "batuhan", "ea", "hops", "mustafa efe okan", "mustafa", "efe", "okan", "ilkin", "i̇lkin", "çağlar keskin", "murat tüzgel", "yiğit yücehan", "selman avcı"];
      names.forEach(n => { clean = clean.replace(new RegExp(`\\b${n}\\b`, 'gi'), ' '); });
      clean = clean.replace(/([\u2700-\u27BF]|[\uE000-\uF8FF]|\uD83C[\uDC00-\uDFFF]|\uD83D[\uDC00-\uDFFF]|[\u2011-\u26FF])/g, ' ').replace(/[\[\]\-\_\.\~\:\(\)\,=\>\<]/g, ' ').replace(/\b(?!151\b)\d+\b/g, ' ').replace(/\s{2,}/g, ' ').trim();
      clean = clean.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
      clean = clean.replace(/\bEtb\b/gi, 'ETB').replace(/\bUpc\b/gi, 'UPC').replace(/\bVmax\b/gi, 'VMAX').replace(/\bVstar\b/gi, 'VSTAR').replace(/\bEx\b/gi, 'EX').replace(/\bBooster Box\b/gi, 'Booster Box').replace(/\bBooster Pack\b/gi, 'Booster Pack').replace(/\bBooster Bundle\b/gi, 'Booster Bundle');
      if (isPC && !clean.includes("Pokemon Center")) { clean += " Pokemon Center"; }
      return clean.trim();
    }

    function refreshDatabase() {
      localMarketData = uploadedChats.flatMap(c => c.data);
      let cm = document.getElementById('chatManager'); cm.innerHTML = '';
      uploadedChats.forEach(c => { cm.innerHTML += `<div class="chat-row"><span>📦 ${c.name} (${c.data.length})</span><button class="chat-del-btn" onclick="deleteChat(${c.id})">Sil</button></div>`; });
      document.getElementById('dbStatus').innerText = uploadedChats.length > 0 ? `${localMarketData.length} İlan Aktif.` : `Sohbet ZIP'i ekleyin.`;
    }

    function deleteChat(id) { 
      uploadedChats = uploadedChats.filter(c => c.id !== id); localStorage.setItem('wa_chats_array', JSON.stringify(uploadedChats)); refreshDatabase(); renderMarketList();
    }

    async function parseWhatsAppZip(e) {
      let file = e.target.files[0]; if(!file) return;
      document.getElementById('dbStatus').innerText = "Yükleniyor... Temizleniyor...";
      try {
        let zip = new JSZip(); let zData = await zip.loadAsync(file); let txt = "";
        for(let fn of Object.keys(zData.files)) { if(fn.endsWith('.txt')) { txt = await zData.files[fn].async("string"); break; } }
        let lines = txt.split('\n'); let data = [];
        const waPrefixRegex = /^\[?\d{1,2}[\/\.]\d{1,2}[\/\.]\d{2,4}[, ]+\d{1,2}:\d{2}(:\d{2})?(?:\s*[A-Z]{2})?\]?\s*[\-~]?\s*([^:]+):/i;

        lines.forEach(line => {
          let low = line.toLowerCase();
          if((low.includes('tl') || low.includes('₺') || low.includes('$')) && (low.includes('etb') || low.includes('bundle') || low.includes('booster') || low.includes('box') || low.includes('pack') || low.includes('partner'))) {
            let lister = "Bilinmiyor"; let pText = line;
            const match = line.match(waPrefixRegex);
            if (match && match[2]) { lister = match[2].trim(); pText = line.replace(match[0], '').trim(); }
            if (lister === 'undefined' || lister === 'null') lister = "Bilinmiyor";
            if (lister.length > 20) lister = lister.substring(0, 18) + '..';

            let mPrice = pText.match(/(\d+(?:[\.\,]\d+)?(?:[\.\,]\d+)?)\s*(tl|\$|₺)/i);
            if(mPrice) {
              let numStr = mPrice[1]; let pMatch = numStr.match(/[\.\,]/g);
              if (pMatch) {
                  let parts = numStr.split(/[\.\,]/); let lastPart = parts.pop(); 
                  if (lastPart.length === 3) numStr = numStr.replace(/[\.\,]/g, '');
                  else numStr = parts.join('').replace(/[\.\,]/g, '') + '.' + lastPart;
              }
              let p = parseFloat(numStr);
              if(low.includes('$')) p *= usdRate; else if(p > 0 && p < 200) p *= 1000;
              let name = extractCleanName(pText);
              if(name.length > 2) data.push({ id: Date.now() + Math.random(), rawText: pText, product: name, lister: lister, price: p });
            }
          }
        });
        uploadedChats.push({ id: Date.now(), name: file.name.substring(0,12), data: data.reverse() });
        localStorage.setItem('wa_chats_array', JSON.stringify(uploadedChats)); refreshDatabase(); renderMarketList();
      } catch(err) { document.getElementById('dbStatus').innerText = "Hata oluştu!"; }
    }

    function getAggregatedMarketData() {
      let groups = {};
      localMarketData.forEach(item => {
        let flag = detectLanguage(item.rawText || item.product);
        let key = `${flag} ${item.product}`;
        if (!groups[key]) groups[key] = { pureName: item.product, flag: flag, fullName: key, listings: [] };
        groups[key].listings.push(item);
      });
      let result = [];
      Object.values(groups).forEach(g => {
        let allPrices = g.listings.map(l => l.price);
        let recentListings = g.listings.slice(0, 4);
        let recentAvg = recentListings.reduce((s, x) => s + x.price, 0) / recentListings.length;
        result.push({ ...g, avgPrice: Math.round(recentAvg), minPrice: Math.min(...allPrices), maxPrice: Math.max(...allPrices), count: g.listings.length });
      });
      return result;
    }

    function renderMarketList() {
      let listEl = document.getElementById('marketTickerList'); if (!listEl) return; listEl.innerHTML = '';
      let query = (document.getElementById('marketSearchInput')?.value || '').toLowerCase().trim();
      let data = getAggregatedMarketData();
      data.sort((a, b) => b.count - a.count || a.fullName.localeCompare(b.fullName));
      let filtered = data.filter(d => d.fullName.toLowerCase().includes(query));
      document.getElementById('marketSummaryCount').innerText = `${filtered.length} Farklı Ürün Takipte`;
      if (filtered.length === 0) { listEl.innerHTML = `<div style="text-align:center; padding:30px; color:var(--text-muted); font-size:13px;">Ürün bulunamadı.</div>`; return; }
      filtered.forEach(p => {
        let card = document.createElement('div'); card.className = 'market-ticker-card'; card.onclick = () => openMarketDetail(p);
        card.innerHTML = `<div class="ticker-left"><div class="product-icon">${getProductIcon(p.pureName)}</div><div><div style="font-weight:700; color:#FFF; font-size:14px; line-height:1.2;">${p.fullName}</div><div style="font-size:11px; color:var(--text-muted); margin-top:4px;">📦 ${p.count} İlan &bull; Aralık: ${formatMoney(p.minPrice)} - ${formatMoney(p.maxPrice)}</div></div></div><div class="ticker-right"><div style="font-size:16px; font-weight:900; color:var(--success);">${formatMoney(p.avgPrice)}</div><div style="font-size:10px; color:#93C5FD; font-weight:700; margin-top:4px;">Ortalama ➔</div></div>`;
        listEl.appendChild(card);
      });
    }

    function openManualAddModal() { document.getElementById('manualAddModal').style.display = 'flex'; }
    function closeManualAddModal() { document.getElementById('manualAddModal').style.display = 'none'; }
    function confirmManualAdd() {
      let name = document.getElementById('manName').value.trim(); let buy = parseFloat(document.getElementById('manBuy').value) || 0; let current = parseFloat(document.getElementById('manMarket').value); let qty = parseInt(document.getElementById('manQty').value) || 1;
      if(!name || isNaN(current)) { alert("Ürün adı ve piyasa fiyatı zorunludur!"); return; }
      collection.unshift({ id: Date.now(), name, buy, current, cond: "Kusursuz (Sealed)", qty, status: 'active' }); saveAndRender();
      document.getElementById('manName').value = ''; document.getElementById('manBuy').value = ''; document.getElementById('manMarket').value = ''; document.getElementById('manQty').value = '1'; closeManualAddModal();
    }

    function searchLocal(e) {
      let q = e.target.value.toLowerCase().trim(); let res = document.getElementById('searchResults');
      if(q.length < 2) { res.style.display = 'none'; return; }
      let data = getAggregatedMarketData(); let queryWords = q.split(' ').filter(w => w.length > 1);
      let scored = data.map(item => { let score = 0; let target = item.fullName.toLowerCase(); if (target.includes(q)) score += 10; queryWords.forEach(word => { if (target.includes(word)) score += 3; }); return { ...item, score }; }).filter(item => item.score > 0);
      scored.sort((a, b) => b.score - a.score); let matches = scored.slice(0, 15);
      if(matches.length === 0) { res.style.display = 'none'; return; } res.innerHTML = '';
      
      let bestMatch = matches[0];
      let estDiv = document.createElement('div'); estDiv.className = 'suggestion-item'; estDiv.style.backgroundColor = 'rgba(16, 185, 129, 0.15)'; estDiv.style.borderBottom = '2px solid rgba(16, 185, 129, 0.4)'; estDiv.onclick = () => selectCard(bestMatch.fullName, bestMatch.avgPrice);
      estDiv.innerHTML = `<div style="display:flex; justify-content:space-between; align-items:center;"><div style="color:#34D399; font-weight:800; font-size:11px; text-transform:uppercase;">💡 Sistem Tahmini (Ortalama)</div><div style="color:#10B981; font-weight:900; font-size:15px;">${bestMatch.avgPrice.toLocaleString('tr-TR')} ₺</div></div><div style="display:flex; align-items:center; gap:8px; margin-top:8px;"><div class="product-icon" style="width:28px; height:28px; min-width:28px; font-size:14px;">${getProductIcon(bestMatch.pureName)}</div><div><div style="color:#FFF; font-weight:700; font-size:14px;">${bestMatch.fullName}</div><div style="font-size:10px; color:#94A3B8; margin-top:2px;">${bestMatch.count} ilan baz alındı. Aralık: ${formatMoney(bestMatch.minPrice)} - ${formatMoney(bestMatch.maxPrice)}</div></div></div>`;
      res.appendChild(estDiv);

      if (matches.length > 1) {
          matches.slice(1).forEach(m => {
            let div = document.createElement('div'); div.className = 'suggestion-item'; div.onclick = () => selectCard(m.fullName, m.avgPrice);
            div.innerHTML = `<div style="display:flex; align-items:center; gap:10px;"><div class="product-icon" style="width:32px; height:32px; min-width:32px; font-size:16px;">${getProductIcon(m.pureName)}</div><div style="flex:1;"><div style="display:flex;justify-content:space-between;font-size:13px;"><span style="color:#FFF;font-weight:700;">${m.fullName}</span><span style="color:#10B981;font-weight:900;">${m.avgPrice.toLocaleString('tr-TR')}₺</span></div><div style="font-size:11px; color:var(--text-muted); margin-top:2px;">${m.count} İlan Ortalaması</div></div></div>`; res.appendChild(div);
          });
      }
      res.style.display = 'block';
    }

    function selectCard(name, price) {
      document.getElementById('cardName').value = name; document.getElementById('currentPrice').value = price; document.getElementById('cardName').style.display = 'none'; document.getElementById('selectedCardNameText').innerText = name; document.getElementById('selectedCardChip').style.display = 'flex'; document.getElementById('searchResults').style.display = 'none';
    }

    function clearSelection() { document.getElementById('cardName').value = ''; document.getElementById('cardName').style.display = 'block'; document.getElementById('selectedCardChip').style.display = 'none'; document.getElementById('currentPrice').value = ''; }
    function saveAndRender() { localStorage.setItem('pkmn_sealed_collection', JSON.stringify(collection)); renderDashboard(); renderCards(); }
    
    function addCard() {
      let name = document.getElementById('cardName').value; if(!name) name = document.getElementById('selectedCardNameText').innerText;
      let buy = parseFloat(document.getElementById('buyPrice').value) || 0; let current = parseFloat(document.getElementById('currentPrice').value); let qty = parseInt(document.getElementById('qtyInput').value) || 1;
      if(!name || isNaN(current)) { alert("Lütfen arama listesinden bir ürün seçin veya sağdaki (+) butonu ile özel ekleyin."); return; }
      collection.unshift({ id: Date.now(), name, buy, current, cond: "Kusursuz (Sealed)", qty, status: 'active' }); saveAndRender(); clearSelection(); document.getElementById('buyPrice').value = ''; document.getElementById('qtyInput').value = '1'; document.getElementById('currentPrice').value = '';
    }

    function updateQty(id, d) { let c = collection.find(x => x.id === id); if(c) { c.qty += d; if(c.qty <= 0) deleteCard(id); else saveAndRender(); } }
    function deleteCard(id) { collection = collection.filter(x => x.id !== id); saveAndRender(); }
    function openSellModal(id) { currentSellId = id; let c = collection.find(x => x.id === id); if(!c) return; document.getElementById('sellModalProductName').innerText = `📦 ${c.name} (Stok: ${c.qty} Adet)`; document.getElementById('sellRows').innerHTML = `<div class="sell-row"><input type="number" class="text-input sell-qty" placeholder="Adet" max="${c.qty}" min="1" value="1" style="flex:0.4;"><input type="number" class="text-input sell-price" placeholder="Birim Satış Fiyatı (₺)" value="${c.current}" style="flex:1;"></div>`; document.getElementById('sellModal').style.display = 'flex'; }
    function addSellRow() { let div = document.createElement('div'); div.className = 'sell-row'; div.innerHTML = `<input type="number" class="text-input sell-qty" placeholder="Adet" min="1" value="1" style="flex:0.4;"><input type="number" class="text-input sell-price" placeholder="Birim Satış Fiyatı (₺)" style="flex:1;"><button class="del-row-btn" onclick="this.parentElement.remove()">✖</button>`; document.getElementById('sellRows').appendChild(div); }
    function closeSellModal() { document.getElementById('sellModal').style.display = 'none'; currentSellId = null; }

    function confirmSale() {
      let c = collection.find(x => x.id === currentSellId); if(!c) return;
      let rows = document.querySelectorAll('.sell-row'); let totalSellQty = 0; let sales = []; let hasError = false;
      rows.forEach(r => { let q = parseInt(r.querySelector('.sell-qty').value); let p = parseFloat(r.querySelector('.sell-price').value); if (isNaN(q) || q <= 0 || isNaN(p) || p < 0) hasError = true; else { totalSellQty += q; sales.push({qty: q, price: p}); } });
      if(hasError) { alert("Lütfen tüm adet ve fiyat alanlarını geçerli doldurun."); return; }
      if(totalSellQty > c.qty) { alert(`Hata: Girdiğiniz toplam adet (${totalSellQty}), mevcut stoktan (${c.qty}) fazla olamaz!`); return; }
      let d = new Date(); let dateStr = `${d.getDate()}/${d.getMonth()+1}/${d.getFullYear()}`; c.qty -= totalSellQty;
      sales.forEach(s => { collection.push({ id: Date.now() + Math.random(), name: c.name, buy: c.buy, current: c.current, cond: c.cond, qty: s.qty, status: 'sold', soldPrice: s.price, soldDate: dateStr }); });
      if(c.qty <= 0) { collection = collection.filter(x => x.id !== currentSellId); } closeSellModal(); saveAndRender();
    }

    function undoSell(id) { let c = collection.find(x => x.id === id); if(c) { c.status = 'active'; delete c.soldPrice; delete c.soldDate; saveAndRender(); } }
    function copyWTS(id) { let c = collection.find(x => x.id === id); if(c) { navigator.clipboard.writeText(`WTS 🟢\n\n📦 ${c.name}\n✨ Kondisyon: ${c.cond}\n💵 Fiyat: ${c.current.toLocaleString('tr-TR')} TL\n\nDM atabilirsiniz.`); alert("WTS metni kopyalandı!"); } }

    function renderDashboard() {
      let activeCards = collection.filter(c => c.status !== 'sold'); let soldCards = collection.filter(c => c.status === 'sold');
      let activeCost = activeCards.reduce((s, c) => s + (c.buy * c.qty), 0); let soldCost = soldCards.reduce((s, c) => s + (c.buy * c.qty), 0);
      let totalSpent = activeCost + soldCost; let activeVal = activeCards.reduce((s, c) => s + (c.current * c.qty), 0);
      let expectedProfit = activeVal - activeCost; let realizedProfit = soldCards.reduce((s, c) => s + ((c.soldPrice - c.buy) * c.qty), 0);
      
      document.getElementById('totalValue').innerText = formatMoney(activeVal); document.getElementById('totalSpent').innerText = formatMoney(totalSpent); document.getElementById('totalCost').innerText = formatMoney(activeCost);
      document.getElementById('expectedProfit').innerText = (expectedProfit >= 0 ? '+' : '') + formatMoney(expectedProfit); document.getElementById('expectedProfit').className = 'stat-value ' + (expectedProfit >= 0 ? 'green' : 'red');
      document.getElementById('realizedProfit').innerText = (realizedProfit >= 0 ? '+' : '') + formatMoney(realizedProfit); document.getElementById('realizedProfit').className = 'stat-value ' + (realizedProfit >= 0 ? 'green' : 'red');

      let productValues = {}; activeCards.forEach(c => { productValues[c.name] = (productValues[c.name] || 0) + (c.current * c.qty); });
      let sortedProducts = Object.entries(productValues).sort((a,b) => b[1] - a[1]);
      let labels = []; let dataVals = [];
      for(let i=0; i < Math.min(4, sortedProducts.length); i++) { labels.push(sortedProducts[i][0].substring(3,15) + '..'); dataVals.push(sortedProducts[i][1]); }
      if(sortedProducts.length > 4) { let otherSum = sortedProducts.slice(4).reduce((s, p) => s + p[1], 0); labels.push('Diğerleri'); dataVals.push(otherSum); }

      let ctx = document.getElementById('portfolioChart').getContext('2d');
      if(portfolioChart) portfolioChart.destroy();
      portfolioChart = new Chart(ctx, { type: 'doughnut', data: { labels: labels, datasets: [{ data: dataVals, backgroundColor: ['#3B82F6', '#10B981', '#F59E0B', '#A855F7', '#64748B'], borderWidth: 0 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right', labels: { boxWidth: 10, font: { size: 9 }, color:'#94A3B8' } } }, cutout: '65%' } });
    }

    function renderCards() {
      let activeList = document.getElementById('cardList'); activeList.innerHTML = ''; let soldList = document.getElementById('soldList'); soldList.innerHTML = '';
      let activeCards = collection.filter(c => c.status !== 'sold'); let soldCards = collection.filter(c => c.status === 'sold');
      let sType = document.getElementById('sortFilter').value;
      if(sType === 'profitDesc') activeCards.sort((a,b) => ((b.current-b.buy)*b.qty) - ((a.current-a.buy)*a.qty)); else if(sType === 'costDesc') activeCards.sort((a,b) => (b.buy*b.qty) - (a.buy*a.qty)); else if(sType === 'az') activeCards.sort((a,b) => a.name.localeCompare(b.name));

      activeCards.forEach(c => {
        let p = (c.current - c.buy) * c.qty; let roi = c.buy > 0 ? `%${(((c.current - c.buy)/c.buy)*100).toFixed(0)}` : 'Trade';
        activeList.innerHTML += `<div class="panel card-item"><div style="display:flex; gap:14px; align-items:center;"><div class="product-icon">${getProductIcon(c.name)}</div><div style="flex:1;"><h3 style="margin:0 0 4px 0; font-size:14px; font-weight:700;">${c.name}</h3><span class="roi-badge">ROI: ${roi}</span><div style="font-size:12px; color:var(--text-muted); margin-top:3px;">Birim Alış: <b>${formatMoney(c.buy)}</b> | Piyasa: <b style="color:var(--success);">${formatMoney(c.current)}</b></div><div class="${p >= 0 ? 'green' : 'red'}" style="font-size:12px; font-weight:800; margin-top:3px;">Beklenen K/Z: ${p >= 0 ? '+' : ''}${formatMoney(p)}</div></div></div><div class="card-actions"><div class="qty-controls"><button class="qty-btn" onclick="updateQty(${c.id}, -1)">-</button><span style="font-size:13px; font-weight:bold; width:28px; text-align:center;">${c.qty}</span><button class="qty-btn" onclick="updateQty(${c.id}, 1)">+</button></div><div style="display:flex; gap:6px;"><button class="wts-btn" onclick="openSellModal(${c.id})" style="background:rgba(16, 185, 129, 0.15); color:#34D399; border-color:rgba(16,185,129,0.3);">Sat</button><button class="wts-btn" onclick="copyWTS(${c.id})">WTS</button><button class="delete-btn" onclick="deleteCard(${c.id})">Sil</button></div></div></div>`;
      });

      soldCards.forEach(c => {
        let p = (c.soldPrice - c.buy) * c.qty; let roi = c.buy > 0 ? `%${(((c.soldPrice - c.buy)/c.buy)*100).toFixed(0)}` : 'Trade';
        soldList.innerHTML += `<div class="panel card-item" style="border-color: rgba(16, 185, 129, 0.3);"><div style="display:flex; gap:14px; align-items:center;"><div class="product-icon" style="opacity:0.6;">${getProductIcon(c.name)}</div><div style="flex:1; opacity:0.85;"><h3 style="margin:0 0 4px 0; font-size:14px; font-weight:700; text-decoration:line-through;">${c.name}</h3><span class="roi-badge" style="background:rgba(16,185,129,0.2); color:#34D399;">Satıldı (${c.qty} Adet)</span><span class="roi-badge">ROI: ${roi}</span><div style="font-size:12px; color:var(--text-muted); margin-top:3px;">Birim Alış: <b>${formatMoney(c.buy)}</b> | Satış: <b style="color:var(--success);">${formatMoney(c.soldPrice)}</b></div><div class="${p >= 0 ? 'green' : 'red'}" style="font-size:12px; font-weight:800; margin-top:3px;">Gerçekleşen Net K/Z: ${p >= 0 ? '+' : ''}${formatMoney(p)}</div></div></div><div class="card-actions" style="justify-content:flex-end;"><div style="display:flex; gap:6px;"><button class="wts-btn" onclick="undoSell(${c.id})" style="background:rgba(245, 158, 11, 0.15); color:#FCD34D; border-color:rgba(245,158,11,0.3);">İptal Et</button><button class="delete-btn" onclick="deleteCard(${c.id})">Sil</button></div></div></div>`;
      });
    }

    initApp();
  </script>
